{
  "name": "yellowsphere-tauri",
  "version": "1.6.7",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "tauri": "tauri",
    "prepare:tauri": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/prepare-tauri-assets.ps1",
    "prepare:tauri:py": "python scripts/prepare_tauri_assets.py",
    "screenshots": "node scripts/capture_screenshots.js",
    "build:tauri": "npm run prepare:tauri && tauri build",
    "build:tauri:mac": "npm run prepare:tauri:py && tauri build --bundles app,dmg",
    "test:smoke": "playwright test tests/yellowsphere-html.smoke.spec.js",
    "test:crypto": "playwright test tests/yellowsphere-encryption.spec.js",
    "test:html": "playwright test tests/yellowsphere-html.smoke.spec.js tests/yellowsphere-encryption.spec.js",
    "test:python": "python tests/python/run_tests.py",
    "test:tauri": "python tests/tauri/run-release-harness.py",
    "test:tauri:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/tauri/windows-release-harness.ps1 -BuildInstallers",
    "test:tauri:windows:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/tauri/windows-release-harness.ps1 -ValidateArtifacts",
    "test:tauri:macos": "bash tests/tauri/macos-release-harness.sh --build-installers",
    "test:tauri:macos:validate": "bash tests/tauri/macos-release-harness.sh --validate-artifacts",
    "test:tauri:linux": "bash tests/tauri/linux-release-harness.sh --build-packages",
    "test:tauri:linux:validate": "bash tests/tauri/linux-release-harness.sh --validate-artifacts",
    "test:release": "npm run test:python && npm run test:html && npm run test:tauri"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "@tauri-apps/cli": "^2.0.0"
  }
}
